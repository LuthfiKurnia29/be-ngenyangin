NODE_ENV=development
PORT=5000

# Supabase Configuration
# Temukan di Dashboard Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Midtrans Configuration
# Temukan di Midtrans Dashboard: Settings -> Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key
MIDTRANS_IS_PRODUCTION=false

# SMTP Configuration (untuk fitur Lupa Password)
# Contoh menggunakan Gmail: aktifkan App Passwords di https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Ngenyangin
SMTP_FROM_EMAIL=noreply@ngenyangin.com

# URL Frontend (untuk link reset password di email)
FRONTEND_URL=http://localhost:3000
